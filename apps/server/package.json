{
  "name": "label-log-server",
  "version": "1.0.0",
  "description": "A back-end service for interacting with LLM API",
  "homepage": "https://github.com/unematiii/log-label-server#readme",
  "bugs": {
    "url": "https://github.com/unematiii/log-label-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/unematiii/log-label-server.git"
  },
  "author": "Mati Kärner",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "build:watch": "tsc -p tsconfig.prod.json -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "whitelist": "node ./dist/database/scripts/whitelist.js",
    "format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json",
    "start": "node ./dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@label-log/contracts": "workspace:*",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.6",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6"
  }
}
