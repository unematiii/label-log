{
  "expo": {
    "name": "LabelLog",
    "slug": "label-log",
    "version": "1.0.0",
    "scheme": "labellog",
    "plugins": ["expo-router", "expo-status-bar"],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/app-Icon-1024x1024@1x.png",
    "android": {
      "package": "com.adaptive.labellog"
    },
    "ios": {
      "bundleIdentifier": "com.adaptive.labellog",
      "icon": "./assets/images/app-Icon-1024x1024@1x.png",
      "infoPlist": {
        "CFBundleDisplayName": "LabelLog",
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your Camera to capture photos and videos.",
        "NSLocalNetworkUsageDescription": "Connect to the nutrition extraction service on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    }
  }
}
