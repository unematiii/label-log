{
  "expo": {
    "name": "LabelLog",
    "slug": "label-log",
    "version": "1.0.0",
    "scheme": "labellog",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "react-native-vision-camera",
        {
          "enableCodeScanner": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/app-Icon-1024x1024@1x.png",
    "android": {
      "package": "com.adaptive.labellog"
    },
    "ios": {
      "bundleIdentifier": "com.adaptive.labellog",
      "icon": "./assets/images/app-Icon-1024x1024@1x.png",
      "infoPlist": {
        "CFBundleDisplayName": "LabelLog",
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your Camera to scan barcodes and nutrition information.",
        "NSLocalNetworkUsageDescription": "Need to access local test server for testing.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    }
  }
}
